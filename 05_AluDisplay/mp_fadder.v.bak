module mp_fadder #(parameter NUM_BITS = 4)(
	input  [N-1:00]	ivDataA,
	input  [N-1:00]	ivDataB,
	input 		  		iCin,
	output [N-1:00]	ovpSumOut,
	output 				oCout
	
);

  wire [NUM_BITS:0] wvCarrie;
  //wire [NUM_BITS-1:0] b_b;
  
  assign wvCarrie[0] = iCin;
    
  genvar i;
  generate
    for (i=0;i<NUM_BITS;i=i+1) begin : adder_loop
      fadder fa_i(.ivDataA(ivDataA[i]),.ivDataB(ivDataB[i]),.iCin(wvCarrie[i]),.ovpSumOut(ovpSumOut[i]),.oCout(wvCarrie[i+1]));
    end
  endgenerate
  
  assign oCout = wvCarrie[NUM_BITS];
 
 endmodule
 
