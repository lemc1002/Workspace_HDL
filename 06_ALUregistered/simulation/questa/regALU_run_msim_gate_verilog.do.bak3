transcript on
if {[file exists gate_work]} {
	vdel -lib gate_work -all
}
vlib gate_work
vmap work gate_work

vlog  -work work +incdir+. {regALU.vo}

vlog  -work work +incdir+C:/altera_ws/Workspace_HDL/06_ALUregistered {C:/altera_ws/Workspace_HDL/06_ALUregistered/tbFAddergenerate.v}

vsim -t 1ps -L altera_ver -L altera_lnsim_ver -L cyclonev_ver -L lpm_ver -L sgate_ver -L cyclonev_hssi_ver -L altera_mf_ver -L cyclonev_pcie_hip_ver -L gate_work -L work -voptargs="+acc"  mFAddergenerate

add wave *
view structure
view signals
run -all
